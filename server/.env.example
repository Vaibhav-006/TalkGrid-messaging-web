# Required — MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/talkgrid

# JWT secret for auth tokens (change in production)
JWT_SECRET=your-secret-here

# Server port (default 3001)
PORT=3001

# Optional — Cloudinary for status uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
